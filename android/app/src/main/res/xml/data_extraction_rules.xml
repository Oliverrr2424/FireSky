<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. The session token lives in
     firesky_secure.xml, encrypted with a key that never leaves this device,
     so it is excluded; caches are rebuilt on demand. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="firesky_secure.xml" />
        <exclude domain="sharedpref" path="firesky_alerts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="firesky_secure.xml" />
        <exclude domain="sharedpref" path="firesky_alerts.xml" />
    </device-transfer>
</data-extraction-rules>
