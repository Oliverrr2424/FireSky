<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FireSky" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/firesky_backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Ignored below API 27; declared here to keep the theme in one place. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:fontFamily">@font/inter_400</item>
    </style>

    <style name="Theme.FireSky.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/firesky_backdrop</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FireSky</item>
    </style>
</resources>
